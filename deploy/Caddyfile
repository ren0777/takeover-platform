{
    # Error logs must not retain capability URLs, cookies or bearer headers.
    log {
        format filter {
            wrap json
            fields {
                request>uri delete
                request>headers delete
            }
        }
    }
}

{$SITE_DOMAIN} {
    encode zstd gzip
    reverse_proxy 127.0.0.1:{$WEB_PORT:3000} {
        # This Caddy instance directly faces clients (DNS-only, no CDN proxy).
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
        flush_interval -1
    }
}
