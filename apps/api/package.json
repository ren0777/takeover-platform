{
  "name": "@takeover/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@takeover/database": "workspace:*",
    "@takeover/shared": "workspace:*",
    "fastify": "5.12.1",
    "zod": "4.5.2"
  },
  "devDependencies": {
    "@takeover/config": "workspace:*",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
