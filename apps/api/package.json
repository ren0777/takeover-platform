{
  "name": "@takeover/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build:workspace-deps": "pnpm --filter @takeover/shared --filter @takeover/database build",
    "predev": "pnpm run build:workspace-deps",
    "dev": "tsx watch src/server.ts",
    "prebuild": "pnpm run build:workspace-deps",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "pretypecheck": "pnpm run build:workspace-deps",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "pretest": "pnpm run build:workspace-deps",
    "test": "vitest run",
    "pretest:integration": "pnpm run build:workspace-deps",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@takeover/database": "workspace:*",
    "@takeover/shared": "workspace:*",
    "fastify": "5.12.1",
    "zod": "4.5.2"
  },
  "devDependencies": {
    "@takeover/config": "workspace:*",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
