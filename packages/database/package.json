{
  "name": "@takeover/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build:workspace-deps": "pnpm --filter @takeover/shared build",
    "prebuild": "pnpm run build:workspace-deps",
    "build": "tsc -p tsconfig.json",
    "pretypecheck": "pnpm run build:workspace-deps",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "pretest": "pnpm run build:workspace-deps",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:test:prepare": "node scripts/prepare-integration-database.mjs",
    "db:validate": "prisma validate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed:territories": "pnpm build && node dist/territory-seed-cli.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@takeover/shared": "workspace:*",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@takeover/config": "workspace:*",
    "@types/pg": "8.23.1",
    "prisma": "7.10.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
